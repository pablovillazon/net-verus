{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Relevance": {
    "MinimumScore": 0.5
  },
  "WebsiteInspection": {
    "Enabled": true,
    "TimeoutSeconds": 3,
    "MaxResponseBytes": 262144
  }
}
