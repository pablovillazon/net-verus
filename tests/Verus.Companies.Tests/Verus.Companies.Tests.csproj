  <ItemGroup>
    <ProjectReference Include="..\..\src\Verus.Companies.Api\Verus.Companies.Api.csproj" />
    <ProjectReference Include="..\..\src\Verus.Companies.Application\Verus.Companies.Application.csproj" />
    <ProjectReference Include="..\..\src\Verus.Companies.Infrastructure\Verus.Companies.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
